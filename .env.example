# Recharga — environment configuration
#
# Copy to .env.local for local development. In production these are set as
# Vercel Environment Variables. Never commit a filled-in .env file.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
# Everything else stays server-side only.

# ---------------------------------------------------------------------------
# Site identity — REQUIRED BEFORE LAUNCH
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonicals, sitemap, OG image
# URLs and JSON-LD @id values. Defaults to https://rechargachargine.com.
# Read at BUILD time — changing it means rebuilding, not just redeploying.
NEXT_PUBLIC_SITE_URL=https://rechargachargine.com

# ---------------------------------------------------------------------------
# Company details (LocalBusiness / Organization schema)
# ---------------------------------------------------------------------------
# Street address and postal code are omitted from the rendered address and
# from schema entirely when blank, rather than being guessed.
NEXT_PUBLIC_STREET_ADDRESS=
NEXT_PUBLIC_POSTAL_CODE=

# Shown in the footer and contact page. Defaults to admin@rechargachargine.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# sameAs profiles — the highest-leverage SEO values on this list
# ---------------------------------------------------------------------------
# Comma-separated absolute URLs to real, official profiles. These feed
# Organization.sameAs and Person.sameAs, which is how Google ties the name
# "Ali Electricwala" or "Sehej Sharma" to this site as the same entity.
# Leave blank rather than guessing — a wrong URL is worse than none.
NEXT_PUBLIC_ORG_PROFILES=
NEXT_PUBLIC_SEHEJ_PROFILES=
NEXT_PUBLIC_ALI_PROFILES=

# ---------------------------------------------------------------------------
# Search engine verification
# ---------------------------------------------------------------------------
# Token only (the content="..." value), not the whole meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# There is nothing to configure here. The site is a static export, so the form
# posts to public/api/contact.php, which runs on the host. Delivery addresses
# live at the top of that file:
#
#   MAIL_TO   = admin@rechargachargine.com   (receives every enquiry)
#   MAIL_FROM = website@rechargachargine.com (envelope sender; must exist)
#
# Both mailboxes must be created in hPanel — see DEPLOY.md section 4.
